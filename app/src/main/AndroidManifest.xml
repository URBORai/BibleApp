<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- localeConfig 只有 API 33 以上的系統「應用程式語言」設定會用到，
         33 以下由 AppCompatDelegate.setApplicationLocales() 在 App 內處理，
         所以標 targetApi 讓 lint 知道這是刻意的 -->
    <application
        android:name=".BibleApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BibleApp" >
        <!-- singleTop：從搜尋結果跳回閱讀畫面時重用既有 instance（走 onNewIntent），
             不再往 back stack 疊第二個 Reader -->
        <activity
            android:name=".VerseReaderActivity"
            android:launchMode="singleTop"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"></action>
                <category android:name="android.intent.category.LAUNCHER"></category>
            </intent-filter>
        </activity>
        <activity
            android:name=".SearchActivity"
            android:exported="false" />
        <activity
            android:name=".SearchResultActivity"
            android:exported="false" />
    </application>
</manifest>