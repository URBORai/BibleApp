<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 語意化配色（深色）：色名需與 values/colors.xml 完全對應，
         系統會依目前 day/night 狀態自動選用正確版本 -->
    <color name="background_primary">#121212</color>
    <color name="background_surface">#1E1E1E</color>
    <color name="background_header">#2A2A2A</color>
    <color name="text_primary">#F0F0F0</color>
    <color name="text_secondary">#B0B0B0</color>
    <color name="text_tertiary">#A0A0A0</color>
    <color name="divider">#383838</color>
    <color name="highlight_verse">#7A5C00</color>
    <!-- 選取底色的深色版：亮度壓低但仍明顯高於背景，經文文字維持可讀 -->
    <color name="selected_verse">#274257</color>
    <!-- 節號強調色：深色底下改用亮版，維持可辨識度 -->
    <color name="verse_number">#F0B357</color>

    <!-- 主題強調色的深色版：底色變暗，強調色改用亮琥珀，壓在上面的前景色跟著翻成近黑 -->
    <color name="accent">#F0B357</color>
    <color name="accent_variant">#D9973B</color>
    <color name="on_accent">#1A1A1A</color>
    <!-- 已勾選格子的深色底，配上亮琥珀文字對比 7.34:1 -->
    <color name="accent_container">#3A2C15</color>

    <!-- 深色背景下提高亮度以維持可辨識度 -->
    <color name="keyword1">#FF6B6B</color>
    <color name="keyword2">#64B5F6</color>
    <color name="keyword3">#81C784</color>
</resources>
