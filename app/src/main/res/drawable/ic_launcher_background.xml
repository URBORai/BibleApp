<?xml version="1.0" encoding="utf-8"?>
<!-- 啟動器圖示的背景層（Adaptive Icon 規格：108x108dp，外圈 18dp 可能被遮罩裁掉）。

     整面鋪 accent 赤陶色，讓圖示在啟動器格線裡夠顯眼、也直接呼應 App 內的強調色。
     加一層很淡的放射漸層（中心略亮、邊緣略暗）避免大色塊看起來死板，
     幅度刻意壓得很小，縮到最小尺寸時只會讀成單一顏色，不會變成髒污。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="44"
                android:gradientRadius="78"
                android:startColor="#BE6B3C"
                android:endColor="#8E4A26" />
        </aapt:attr>
    </path>

</vector>
