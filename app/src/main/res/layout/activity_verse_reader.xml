<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- 導覽工具列：膠囊容器 + 分隔線做出 segmented control 的視覺。
         按鈕內距刻意收窄（12dp），讓英文介面的 Old / New / Chapter 也能整排塞進 360dp 寬的螢幕。
         真的還是塞不下時（超大系統字級、超窄螢幕）仍可橫向捲動，
         fadingEdge 讓超出的部分淡出，看起來是「還有內容可以捲」而不是「被切掉」 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:clipToPadding="false"
        android:requiresFadingEdge="horizontal"
        android:fadingEdgeLength="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_toolbar_segmented"
            android:divider="@drawable/divider_toolbar_segment"
            android:showDividers="middle"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnOpenSearch"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:contentDescription="@string/action_search"
                android:text="@string/icon_search" />

            <Button
                android:id="@+id/btnOldTestament"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:contentDescription="@string/old_testament_full"
                android:text="@string/old_testament" />

            <Button
                android:id="@+id/btnNewTestament"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:contentDescription="@string/new_testament_full"
                android:text="@string/new_testament" />

            <Button
                android:id="@+id/btnChapterPicker"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:text="@string/chapter_picker" />

            <Button
                android:id="@+id/btnThemeSettings"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:contentDescription="@string/appearance_settings"
                android:text="@string/icon_settings" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- 閱讀設定列：沿用同一組膠囊樣式，跟上排維持一致 -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_toolbar_segmented"
        android:divider="@drawable/divider_toolbar_segment"
        android:showDividers="middle"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnToggleParallel"
            style="?attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:textAllCaps="false"
            android:textColor="@color/text_primary"
            android:text="@string/toggle_parallel_show" />

        <Button
            android:id="@+id/btnDecreaseFont"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/text_primary"
            android:contentDescription="@string/cd_decrease_font"
            android:text="@string/icon_font_decrease" />

        <Button
            android:id="@+id/btnIncreaseFont"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/text_primary"
            android:contentDescription="@string/cd_increase_font"
            android:text="@string/icon_font_increase" />

    </LinearLayout>

    <!-- 目前位置標題：每次 loadChapter 完成後由程式更新，是獨立一列，不會被浮動按鈕蓋到 -->
    <TextView
        android:id="@+id/textCurrentLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp"
        android:textColor="@color/text_primary"
        android:textSize="21sp"
        android:textStyle="bold"
        android:text="" />

    <!-- 經文區與浮動按鈕疊在一起，按鈕只蓋在閱讀區上方，不會壓到上面的工具列與標題列 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 底部留白 + clipToPadding=false：最後幾節可以捲到浮動按鈕上方，不會被永久擋住 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerVerses"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="72dp" />

        <!-- 查無經文時的提示，蓋在經文區中央；平時 gone，由 showChapter() 切換 -->
        <TextView
            android:id="@+id/textChapterEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="24dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:visibility="gone"
            android:text="@string/chapter_not_found" />

        <!-- 選取某一節後浮出的複製列：沿用工具列的膠囊樣式，置中在兩顆翻頁按鈕之間，
             不會蓋到經文（RecyclerView 已有 72dp 底部留白可捲上來）。平時 gone -->
        <LinearLayout
            android:id="@+id/layoutCopyBar"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_toolbar_segmented"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnCopyVerse"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:contentDescription="@string/cd_copy_verse"
                android:text="@string/action_copy_verse" />

        </LinearLayout>

        <!-- 初始為停用樣式，等第一次 loadChapter 完成後才由程式依邊界狀況啟用 -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPreviousChapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:alpha="0.3"
            android:enabled="false"
            android:contentDescription="@string/cd_previous_chapter"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_chapter_previous" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabNextChapter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:alpha="0.3"
            android:enabled="false"
            android:contentDescription="@string/cd_next_chapter"
            app:fabSize="mini"
            app:srcCompat="@drawable/ic_chapter_next" />

    </FrameLayout>

</LinearLayout>
