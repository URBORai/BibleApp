<?xml version="1.0" encoding="utf-8"?>
<!-- 齒輪（外觀設定）對話框：深淺色模式 + 介面顯示語言 + 閱讀相關的顯示開關。
     三段用分隔線與小標題區隔；內容較高時外層 ScrollView 保證小螢幕也能捲到底 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:text="@string/appearance_theme_section" />

        <RadioGroup
            android:id="@+id/groupThemeMode"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioThemeSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:textColor="@color/text_primary"
                android:text="@string/theme_system" />

            <RadioButton
                android:id="@+id/radioThemeLight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:textColor="@color/text_primary"
                android:text="@string/theme_light" />

            <RadioButton
                android:id="@+id/radioThemeDark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:textColor="@color/text_primary"
                android:text="@string/theme_dark" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider" />

        <!-- 介面顯示語言：只換 UI 文字，不影響經文版本（那個在搜尋畫面另外選） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:text="@string/appearance_language_section" />

        <RadioGroup
            android:id="@+id/groupLanguage"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioLanguageSystem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:textColor="@color/text_primary"
                android:text="@string/language_system" />

            <RadioButton
                android:id="@+id/radioLanguageChinese"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:textColor="@color/text_primary"
                android:text="@string/language_chinese" />

            <RadioButton
                android:id="@+id/radioLanguageEnglish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:textColor="@color/text_primary"
                android:text="@string/language_english" />

        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider" />

        <!-- 護眼模式跟上面的深／淺色是兩回事：這是疊一層暖色濾鏡，兩者可以同時開 -->
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchNightReading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:textColor="@color/text_primary"
            android:text="@string/night_reading_mode" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:text="@string/night_reading_mode_hint" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchPageNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:textColor="@color/text_primary"
            android:text="@string/show_page_number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:text="@string/show_page_number_hint" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchHomeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:textColor="@color/text_primary"
            android:text="@string/show_home_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:text="@string/show_home_button_hint" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/divider" />

        <!-- 章節分頁：只作用在章節選擇網格。書卷最多 66 卷、4 欄排下來也只有 17 列，
             不需要翻頁，所以這一段的設定完全不碰書卷網格 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:text="@string/appearance_chapter_paging_section" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchChapterPaging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="44dp"
            android:textColor="@color/text_primary"
            android:text="@string/chapter_paging" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:text="@string/chapter_paging_hint" />

        <!-- 每頁章節數用固定選項而不是數字輸入框：對話框裡跳出數字鍵盤會蓋掉半個畫面，
             還得處理空字串、0、999 這些沒意義的輸入。三個預設值都是 5 欄的倍數，
             每頁都填滿整列。橫排讓這組選項只占一列高，不會把對話框撐長。
             開關關閉時整組由 VerseReaderActivity 停用並調淡，表示它從屬於上面的開關 -->
        <TextView
            android:id="@+id/textChapterPageSizeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:text="@string/chapter_paging_size_label" />

        <RadioGroup
            android:id="@+id/groupChapterPageSize"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioChapterPageSize30"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:textColor="@color/text_primary"
                android:text="@string/chapter_paging_size_30" />

            <RadioButton
                android:id="@+id/radioChapterPageSize50"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:textColor="@color/text_primary"
                android:text="@string/chapter_paging_size_50" />

            <RadioButton
                android:id="@+id/radioChapterPageSize100"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:textColor="@color/text_primary"
                android:text="@string/chapter_paging_size_100" />

        </RadioGroup>

    </LinearLayout>

</ScrollView>
