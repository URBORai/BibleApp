<resources>
    <!-- 預設（中文）介面文案。英文版在 values-en/strings.xml，
         系統語言為英文時自動套用；使用者也可在「外觀設定」裡手動指定。
         注意：這裡只有「介面文字」。聖經經文本身（CUV／NKJV）一律來自資料庫，
         不隨介面語言改變，也不要搬到這裡。 -->

    <string name="app_name">BibleApp</string>

    <!-- 共用動作 -->
    <string name="action_search">搜尋</string>
    <string name="action_cancel">取消</string>
    <string name="action_done">完成</string>
    <string name="action_confirm">確定</string>
    <string name="action_home">返回首頁</string>
    <string name="action_copy_verse">複製這節</string>
    <string name="cd_copy_verse">複製這節經文</string>

    <!-- 閱讀畫面：工具列 -->
    <!-- 工具列按鈕標籤要短，才不會把這排擠爆；完整名稱放在 cd_* 給 TalkBack 唸 -->
    <string name="old_testament">舊約</string>
    <string name="new_testament">新約</string>
    <string name="old_testament_full">舊約</string>
    <string name="new_testament_full">新約</string>
    <string name="chapter_picker">章</string>
    <!-- 兩個跳轉入口的工具列標籤：跟「舊約／新約／章」一樣壓到兩個字，
         完整說法放在 jump_*_title，同時當按鈕的 contentDescription 與對話框標題 -->
    <string name="jump_page_button">頁碼</string>
    <string name="jump_book_button">編號</string>
    <!-- 對照按鈕：文案講的是「對照版本」那一邊。中文介面下對照是英文，
         英文介面（values-en）下對照變成中文，兩邊各自寫死自己的語境即可 -->
    <string name="toggle_parallel_show">顯示英文對照</string>
    <string name="toggle_parallel_hide">隱藏英文對照</string>
    <string name="cd_decrease_font">縮小字級</string>
    <string name="cd_increase_font">放大字級</string>
    <string name="cd_previous_chapter">上一章</string>
    <string name="cd_next_chapter">下一章</string>

    <!-- 閱讀畫面：內容
         current_location 的 %1$s 是書卷名，來自資料庫的 cn_name，不受介面語言影響 -->
    <string name="current_location">%1$s 第%2$d章</string>
    <string name="chapter_not_found">找不到這個章節</string>
    <string name="no_parallel_text">（此節無對應英文譯文）</string>
    <string name="page_number">p.%1$d</string>
    <string name="copied_verse">已複製這節經文</string>
    <string name="clipboard_label">經文</string>

    <!-- 跳轉對話框。
         jump_error_* 的邊界訊息一律把「有效範圍是多少」講出來，
         只說「輸入錯誤」等於要使用者自己猜 -->
    <string name="jump_page_title">頁碼跳轉</string>
    <string name="jump_page_testament_note">和合本的舊約與新約各自從第 1 頁起算，請先選要跳到哪一半</string>
    <!-- %1$s 後面不留空白：代入的是「舊約」「新約」這種中文詞，
         中文詞與後面的字之間不該有空格（英文版另有自己的寫法） -->
    <string name="jump_page_hint">輸入紙本頁碼（%1$s為 1 到 %2$d），跳到該頁的第一節</string>
    <string name="jump_field_page">頁碼</string>
    <string name="jump_error_page_empty">請輸入頁碼</string>
    <string name="jump_error_page_range">頁碼超出範圍，%1$s是 1 到 %2$d</string>
    <string name="jump_error_page_missing">%1$s第 %2$d 頁沒有對應的經文</string>

    <string name="jump_book_title">書卷編號跳轉</string>
    <string name="jump_book_hint">書卷編號為正典順序 1 到 %1$d（1 = 創世記、2 = 出埃及記）。節可留空，只跳到該章開頭</string>
    <string name="jump_field_book">書卷</string>
    <string name="jump_field_chapter">章</string>
    <string name="jump_field_verse">節（可留空）</string>
    <string name="jump_error_book">請輸入 1 到 %1$d 之間的書卷編號</string>
    <!-- 中文沒有單複數變化，只需要 other；用 plurals 是為了英文版
         （俄巴底亞書、腓利門書、猶大書、約翰二／三書都只有一章） -->
    <plurals name="jump_error_chapter">
        <item quantity="other">%1$s 共 %2$d 章，請輸入 1 到 %2$d</item>
    </plurals>
    <string name="jump_error_chapter_missing">%1$s 沒有第 %2$d 章</string>
    <string name="jump_error_verse">%1$s 第%2$d章沒有第 %3$d 節</string>

    <!-- 外觀設定對話框 -->
    <string name="appearance_settings">外觀設定</string>
    <!-- 四個分類區塊的標題 -->
    <string name="appearance_section_display">外觀</string>
    <string name="appearance_section_reading">閱讀</string>
    <string name="appearance_section_navigation">導覽</string>
    <string name="appearance_language_section">顯示語言</string>
    <string name="appearance_theme_section">主題模式</string>
    <string name="theme_system">跟隨系統</string>
    <string name="theme_light">淺色</string>
    <string name="theme_dark">深色</string>
    <string name="language_system">跟隨系統</string>
    <string name="night_reading_mode">護眼模式</string>
    <string name="night_reading_mode_hint">在閱讀畫面疊一層暖色濾鏡降低藍光，可與深色模式同時使用</string>
    <string name="show_page_number">顯示頁碼</string>
    <string name="show_page_number_hint">在每節右下角標示紙本頁碼（僅中文和合本有此資料）</string>
    <string name="show_home_button">顯示返回首頁按鈕</string>
    <string name="show_home_button_hint">在搜尋畫面顯示捷徑，一鍵回到剛才讀到的章節</string>
    <string name="show_page_jump">顯示頁碼跳轉</string>
    <string name="show_page_jump_hint">在閱讀畫面工具列顯示入口，輸入紙本頁碼直接跳過去</string>
    <string name="show_book_number_jump">顯示書卷編號跳轉</string>
    <string name="show_book_number_jump_hint">在閱讀畫面工具列顯示入口，用書卷編號、章、節三個數字直接跳過去</string>
    <string name="appearance_chapter_paging_section">章節選擇</string>
    <string name="chapter_paging">限制每頁章節數</string>
    <string name="chapter_paging_hint">章數多的書卷（如詩篇 150 章）分成多頁，用翻頁取代一直往下滑。不影響書卷選擇</string>
    <string name="chapter_paging_size_label">每頁章節數</string>

    <!-- 網格選擇器的翻頁列 -->
    <string name="grid_page_previous">上一頁</string>
    <string name="grid_page_next">下一頁</string>
    <string name="grid_page_indicator">第 %1$d / %2$d 頁</string>

    <!-- 語言名稱一律以該語言自己的寫法呈現，兩種介面語言下都一樣，不翻譯 -->
    <string name="language_chinese" translatable="false">中文</string>
    <string name="language_english" translatable="false">English</string>

    <!-- 搜尋畫面。
         search_version_* 選的是「要查哪個版本的經文」（CUV／NKJV），
         跟上面的「顯示語言」是兩回事，不要合併 -->
    <string name="search_title">搜尋經文</string>
    <string name="search_hint_keyword1">關鍵字（必填）</string>
    <string name="search_multi_keyword">多關鍵字</string>
    <string name="search_hint_keyword2">關鍵字 2（可留空）</string>
    <string name="search_hint_keyword3">關鍵字 3（可留空）</string>
    <string name="search_match_and">AND（同時符合）</string>
    <string name="search_match_or">OR（符合其一）</string>
    <string name="search_version_chinese">中文</string>
    <string name="search_version_english">英文</string>
    <string name="search_no_result">查無符合的經文</string>
    <string name="search_result_location">第%1$d章 第%2$d節</string>
    <string name="search_scope_button">範圍：%1$s</string>
    <string name="search_scope_title">搜尋範圍</string>
    <string name="search_scope_all">全部</string>
    <string name="search_scope_custom">自訂範圍</string>
    <string name="search_scope_custom_title">選擇要搜尋的書卷</string>
    <plurals name="search_scope_custom_count">
        <item quantity="other">%1$d 卷已選</item>
    </plurals>
    <string name="search_history_title">最近搜尋</string>
    <string name="search_history_clear">清除</string>

    <!-- 搜尋歷史那一列的小標籤，都是版本代碼與運算子，兩種語言相同，不需翻譯 -->
    <string name="search_history_separator" translatable="false">" · "</string>
    <string name="search_history_meta" translatable="false">%1$s · %2$s</string>
    <string name="search_history_and" translatable="false">AND</string>
    <string name="search_history_or" translatable="false">OR</string>

    <!-- 每頁章節數的選項標籤：純數字，兩種語言相同，不需翻譯。
         數值要跟 ChapterPagingPrefs.PAGE_SIZE_OPTIONS 對得起來 -->
    <string name="chapter_paging_size_30" translatable="false">30</string>
    <string name="chapter_paging_size_50" translatable="false">50</string>
    <string name="chapter_paging_size_100" translatable="false">100</string>

    <!-- 純圖示／符號按鈕，兩種語言相同，不需翻譯 -->
    <string name="icon_search" translatable="false">🔍</string>
    <string name="icon_settings" translatable="false">⚙</string>
    <string name="icon_font_decrease" translatable="false">A-</string>
    <string name="icon_font_increase" translatable="false">A+</string>

</resources>
